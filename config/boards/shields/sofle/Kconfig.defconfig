# common stuff
config ZMK_DISPLAY
    default y

config ZMK_SPLIT
    default y

# specific to central device
if ZMK_SPLIT_ROLE_CENTRAL

config ZMK_KEYBOARD_NAME
    default "sofle-peixoto"

# when the left shield is a central device
if SHIELD_SOFLE_LEFT

config ZMK_WIDGET_WPM_STATUS
    default y

config ZMK_WIDGET_LAYER_STATUS
    default y

config ZMK_WIDGET_BATTERY_STATUS_SHOW_PERCENTAGE
    default y

endif # SHIELD_SOFLE_LEFT

endif # ZMK_SPLIT_ROLE_CENTRAL

# for peripherals
if !ZMK_SPLIT_ROLE_CENTRAL

config ZMK_WIDGET_PERIPHERAL_STATUS
    default y

config ZMK_WIDGET_BATTERY_STATUS_SHOW_PERCENTAGE
    default y

endif

# for the dongle specifically

if SHIELD_SOFLE_DONGLE

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Set this to the number of peripherals your dongle will have.
# For a unibody, this would be 1. If you have left and right halves, set it to 2, etc.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Set this to ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS + your desired number of BT profiles (default is 5)
config BT_MAX_CONN
    default 7

# Set this to the same number as BT_MAX_CONN
config BT_MAX_PAIRED
    default 7

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif # SHIELD_SOFLE_DONGLE
